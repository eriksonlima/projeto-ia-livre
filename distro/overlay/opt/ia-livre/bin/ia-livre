#!/usr/bin/env bash
# Wrapper TTY do SO IA Livre (scaffold). Lê /etc/ia-livre/ia-livre.conf ou overlay.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
# Se instalado em /opt/ia-livre/bin, ROOT vira / — conf em /etc
if [[ -f /etc/ia-livre/ia-livre.conf ]]; then
  CONF=/etc/ia-livre/ia-livre.conf
  BIN_DIR=/opt/ia-livre/bin
  MODELS_DIR=/var/lib/ia-livre/models
  CATALOG="${IA_LIVRE_MODELS_CATALOG:-/etc/ia-livre/models-catalog.tsv}"
  # shellcheck disable=SC1090
  set -a
  # shellcheck source=/dev/null
  source "$CONF"
  set +a
else
  CONF="$ROOT/etc/ia-livre/ia-livre.conf"
  BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
  MODELS_DIR="$ROOT/var/lib/ia-livre/models"
  CATALOG="${IA_LIVRE_MODELS_CATALOG:-$ROOT/etc/ia-livre/models-catalog.tsv}"
  # shellcheck disable=SC1090
  set -a
  # shellcheck source=/dev/null
  source "$CONF"
  set +a
  if [[ "${IA_LIVRE_MODEL}" == /var/lib/* ]]; then
    IA_LIVRE_MODEL="$ROOT${IA_LIVRE_MODEL}"
  fi
  if [[ "${IA_LIVRE_AGENT_MEMORY}" == /var/lib/* ]]; then
    IA_LIVRE_AGENT_MEMORY="$ROOT${IA_LIVRE_AGENT_MEMORY}"
  fi
fi

MODEL="${IA_LIVRE_MODEL:?}"
N_PREDICT="${IA_LIVRE_N_PREDICT:-32}"
N_GPU="${IA_LIVRE_N_GPU_LAYERS:-0}"
MEM="${IA_LIVRE_AGENT_MEMORY:-/var/lib/ia-livre/agent-memory/memory.jsonl}"

catalog_lookup() {
  # $1 = id ou nome de arquivo → imprime: id|size|file|url|note
  local key="$1"
  local line id size file url note
  [[ -f "$CATALOG" ]] || return 1
  while IFS=$'\t' read -r id size file url note || [[ -n "${id:-}" ]]; do
    [[ -z "${id:-}" || "$id" == \#* ]] && continue
    if [[ "$key" == "$id" || "$key" == "$file" || "$key" == "$(basename "$file")" ]]; then
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$size" "$file" "$url" "${note:-}"
      return 0
    fi
  done <"$CATALOG"
  return 1
}

persist_conf_model() {
  local new_path="$1"
  local abs
  abs="$(cd "$(dirname "$new_path")" && pwd)/$(basename "$new_path")"
  if [[ ! -f "$abs" ]]; then
    echo "erro: GGUF ausente: $abs" >&2
    exit 1
  fi
  # Guarda path "de sistema" se sob overlay
  local store="$abs"
  if [[ -n "${ROOT:-}" && "$abs" == "$ROOT"/var/lib/ia-livre/models/* ]]; then
    store="/var/lib/ia-livre/models/$(basename "$abs")"
  elif [[ "$abs" == /var/lib/ia-livre/models/* ]]; then
    store="$abs"
  fi
  if grep -q '^IA_LIVRE_MODEL=' "$CONF" 2>/dev/null; then
    sed -i "s|^IA_LIVRE_MODEL=.*|IA_LIVRE_MODEL=${store}|" "$CONF"
  else
    echo "IA_LIVRE_MODEL=${store}" >>"$CONF"
  fi
  echo "IA_LIVRE_MODEL_SET=$store"
  echo "IA_LIVRE_MODEL_FILE=$abs"
}

usage() {
  cat <<EOF
Uso: ia-livre <comando> [args]

  infer [args…]          runtime --model \$IA_LIVRE_MODEL …
  agent [args…]          agent --model … --memory …
  node [args…]           ia-livre-node …
  model list             lista *.gguf já baixados em models/
  model catalog          lista modelos que dá para baixar (catálogo)
  model set <arquivo>    define IA_LIVRE_MODEL (qualquer GGUF) e grava conf
  model show             mostra modelo efetivo
  model fetch [id]       baixa do catálogo (default: tinyllama) ou arquivo; URL via IA_LIVRE_MODEL_URL
  conf                   mostra config efetiva
  help

Models dir: $MODELS_DIR
Catálogo: $CATALOG
Config: $CONF
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  infer)
    exec "$BIN_DIR/ia-livre-runtime" \
      --model "$MODEL" \
      --n-predict "$N_PREDICT" \
      --n-gpu-layers "$N_GPU" \
      "$@"
    ;;
  agent)
    mkdir -p "$(dirname "$MEM")"
    exec "$BIN_DIR/ia-livre-agent" \
      --model "$MODEL" \
      --memory "$MEM" \
      --n-predict "$N_PREDICT" \
      "$@"
    ;;
  node)
    exec "$BIN_DIR/ia-livre-node" "$@"
    ;;
  model)
    sub="${1:-show}"
    shift || true
    case "$sub" in
      list)
        mkdir -p "$MODELS_DIR"
        shopt -s nullglob
        local_ggufs=("$MODELS_DIR"/*.gguf)
        if ((${#local_ggufs[@]} == 0)); then
          echo "(nenhum .gguf em $MODELS_DIR)"
          echo "Copie qualquer GGUF para lá e rode: ia-livre model set <arquivo>"
        else
          for f in "${local_ggufs[@]}"; do
            echo "$(basename "$f")	$f"
          done
        fi
        echo "IA_LIVRE_MODEL_LIST_OK"
        ;;
      set)
        target="${1:-}"
        if [[ -z "$target" ]]; then
          echo "uso: ia-livre model set <caminho.gguf>" >&2
          exit 1
        fi
        if [[ "$target" != /* && ! -f "$target" ]]; then
          target="$MODELS_DIR/$target"
        fi
        persist_conf_model "$target"
        echo "IA_LIVRE_MODEL_OK"
        ;;
      show)
        echo "MODEL=$MODEL"
        if [[ -f "$MODEL" ]]; then
          echo "IA_LIVRE_MODEL_OK"
        else
          echo "IA_LIVRE_MODEL_MISSING=1"
          exit 1
        fi
        ;;
      catalog)
        if [[ ! -f "$CATALOG" ]]; then
          echo "erro: catálogo ausente: $CATALOG" >&2
          exit 1
        fi
        printf '%-14s %-10s %s\n' "ID" "TAMANHO" "NOTA"
        printf '%-14s %-10s %s\n' "--------------" "----------" "----"
        while IFS=$'\t' read -r id size file url note || [[ -n "${id:-}" ]]; do
          [[ -z "${id:-}" || "$id" == \#* ]] && continue
          printf '%-14s %-10s %s\n' "$id" "$size" "${note:-$file}"
        done <"$CATALOG"
        echo
        echo "Baixar: ia-livre model fetch <id>   (ex.: ia-livre model fetch tinyllama)"
        echo "Locais:  ia-livre model list"
        echo "IA_LIVRE_MODEL_CATALOG_OK"
        ;;
      fetch)
        mkdir -p "$MODELS_DIR"
        key="${1:-tinyllama}"
        name=""
        url=""
        size_hint=""
        if [[ -n "${IA_LIVRE_MODEL_URL:-}" ]]; then
          name="$(basename "${2:-$key}")"
          [[ "$name" == *.gguf ]] || name="${name}.gguf"
          url="$IA_LIVRE_MODEL_URL"
        elif row="$(catalog_lookup "$key")"; then
          IFS=$'\t' read -r _cid size_hint name url _note <<<"$row"
        elif [[ "$key" == *.gguf || "$key" == http* ]]; then
          if [[ "$key" == http* ]]; then
            url="$key"
            name="$(basename "${key%%\?*}")"
          else
            name="$key"
            url="https://huggingface.co/TheBloke/TinyLlama-1.1B-Chat-v1.0-GGUF/resolve/main/${name}"
          fi
        else
          echo "erro: id desconhecido '$key'. Rode: ia-livre model catalog" >&2
          exit 1
        fi
        dest="$MODELS_DIR/$name"
        if [[ -f "$dest" ]]; then
          echo "já presente: $dest"
          ls -lh "$dest"
        else
          if ! command -v curl >/dev/null 2>&1; then
            echo "erro: instale curl (sudo apt install -y curl)" >&2
            exit 1
          fi
          echo "baixando $name ${size_hint:+($size_hint)}…"
          echo "URL: $url"
          tmp="$dest.partial"
          curl -fL --progress-bar -o "$tmp" "$url"
          mv "$tmp" "$dest"
          ls -lh "$dest"
        fi
        persist_conf_model "$dest"
        echo "IA_LIVRE_MODEL_FETCH_OK"
        echo "IA_LIVRE_MODEL_OK"
        ;;
      *)
        echo "subcomando model desconhecido: $sub" >&2
        echo "uso: ia-livre model list|catalog|set|show|fetch" >&2
        exit 1
        ;;
    esac
    ;;
  conf)
    echo "CONF=$CONF"
    echo "MODEL=$MODEL"
    echo "N_PREDICT=$N_PREDICT"
    echo "N_GPU_LAYERS=$N_GPU"
    echo "MEMORY=$MEM"
    echo "BIN_DIR=$BIN_DIR"
    echo "MODELS_DIR=$MODELS_DIR"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "comando desconhecido: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
